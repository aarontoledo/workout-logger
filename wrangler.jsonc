/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alloy-workout-logger",
  "compatibility_date": "2026-03-01",
  // Static single-page app: no Worker script, data lives in the browser's localStorage.
  "assets": {
    "not_found_handling": "single-page-application"
  },
  // Custom domain: Cloudflare creates the DNS record and certificate on deploy.
  "routes": [
    { "pattern": "workout-logger.aarontoledo.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
